    "videobuf2-v4l2.c" -> "printk.h";
    "videobuf2-v4l2.c" -> "mutex.h";
    "videobuf2-v4l2.c" -> "err.h";
    "videobuf2-v4l2.c" -> "v4l2-common.h";
    "videobuf2-v4l2.c" -> "string_fortified.h";
    "hantro_postproc.c" -> "dma-mapping.h";
    "v4l2-ioctl.c" -> "generic-non-atomic.h";
    "v4l2-ctrls-core.c" -> "list.h";
    "v4l2-ctrls-core.c" -> "string.h";
    "v4l2-ctrls-core.c" -> "mutex.h";
    "v4l2-ctrls-core.c" -> "slab.h";
    "videobuf2-core.c" -> "list.h";
    "videobuf2-core.c" -> "generic-non-atomic.h";
    "videobuf2-core.c" -> "kernel.h";
    "videobuf2-core.c" -> "printk.h";
    "frame_vector.c" -> "bitops.h";
    "videobuf2-core.c" -> "instrumented-atomic.h";
    "videobuf2-core.c" -> "bitmap.h";
    "videobuf2-core.c" -> "atomic-instrumented.h";
    "videobuf2-core.c" -> "dma-buf.h";
    "videobuf2-core.c" -> "vb2.h";
    "videobuf2-dma-contig.c" -> "cache.h";
    "videobuf2-dma-contig.c" -> "printk.h";
    "videobuf2-dma-contig.c" -> "refcount.h";
    "videobuf2-dma-contig.c" -> "frame_vector.h";
    "videobuf2-dma-contig.c" -> "dma-buf.h";
    "v4l2-mem2mem.c" -> "list.h";
    "v4l2-mem2mem.c" -> "kernel.h";
    "v4l2-mem2mem.c" -> "printk.h";
    "v4l2-mem2mem.c" -> "atomic-instrumented.h";
