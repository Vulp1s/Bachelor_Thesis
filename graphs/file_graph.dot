digraph G {
    // --- Global Configuration ---
    graph [
        rankdir=TB;
        nodesep=0.25;
        ranksep=0.4;
        pad=0.5;
        bgcolor=white;
        splines=true;
        compound=true; // Allows cross-cluster routing optimization
    ]
    
    node [
        fontname="Helvetica,Arial,sans-serif";
        fontsize=11;
        shape=box;
        style="filled,rounded";
        fillcolor="#f9f9f9";
        color="#444444";
        penwidth=1.2;
    ]
    
    edge [
        fontname="Helvetica,Arial,sans-serif";
        fontsize=9;
        color="#444444";
        arrowsize=0.7;
        penwidth=1.0;
    ]

    subgraph cluster_1_Driver {
        label = "1_Driver";
        color = blue;
        "hantro_v4l2.c";
        "hantro_hw.h";
        "hantro.h";
        "hantro_postproc.c";
        "rockchip_av1_entropymode.c";
        "v4l2-mem2mem.c";
        "hantro_drv.c";
        "videobuf2-core.c";
        "v4l2-ctrls-core.c";
        "v4l2-ioctl.c";
        "rockchip_av1_filmgrain.c";
        "rockchip_vpu981_hw_av1_dec.c";
    }

    subgraph cluster_2_SubSystem {
        label = "2_SubSystem";
        color = green;
        "v4l2-ctrls-request.c";
        "v4l2-ctrls-defs.c";
        "v4l2-event.c";
        "v4l2-ctrls-api.c";
        "v4l2-ctrls-priv.h";
        "v4l2-common.c";
        "v4l2-dev.c";
        "videobuf2-v4l2.c";
        "videobuf2-core.h";
        "videobuf2-dma-contig.h";
        "videobuf2-dma-contig.c";
        "frame_vector.c";
        "videobuf2-memops.c";
    }

    subgraph cluster_3_kernel {
        label = "3_kernel";
        color = red;
        "bug.h";
        "v4l2-mem2mem.h";
        "pm_runtime.h";
        "clk.h";
        "spinlock.h";
        "qspinlock.h";
        "list.h";
        "slab.h";
        "media-request.h";
        "v4l2-dev.h";
        "v4l2-ctrls.h";
        "printk.h";
        "mutex.h";
        "err.h";
        "v4l2-common.h";
        "string_fortified.h";
        "dma-mapping.h";
        "generic-non-atomic.h";
        "string.h";
        "kernel.h";
        "bitops.h";
        "instrumented-atomic.h";
        "bitmap.h";
        "atomic-instrumented.h";
        "dma-buf.h";
        "vb2.h";
        "cache.h";
        "refcount.h";
        "frame_vector.h";
        "io.h";
        "mm.h";
        "overflow.h";
        "mmzone.h";
    }

    // Unique Call Relations (Labels & Self-Loops Removed)
    "hantro_v4l2.c" -> "hantro_hw.h";
    "hantro.h" -> "hantro_postproc.c";
    "v4l2-mem2mem.c" -> "hantro_drv.c";
    "videobuf2-core.c" -> "hantro_v4l2.c";
    "v4l2-ctrls-core.c" -> "hantro_drv.c";
    "v4l2-ioctl.c" -> "hantro_v4l2.c";
    "hantro_postproc.c" -> "hantro_hw.h";
    "hantro_postproc.c" -> "hantro_v4l2.c";
    "hantro_postproc.c" -> "rockchip_vpu981_hw_av1_dec.c";
    "hantro_v4l2.c" -> "hantro.h";
    "hantro_v4l2.c" -> "hantro_postproc.c";
    "hantro_v4l2.c" -> "rockchip_vpu981_hw_av1_dec.c";
    "rockchip_vpu981_hw_av1_dec.c" -> "hantro.h";
    "rockchip_vpu981_hw_av1_dec.c" -> "rockchip_av1_entropymode.c";
    "rockchip_vpu981_hw_av1_dec.c" -> "rockchip_av1_filmgrain.c";
    "rockchip_vpu981_hw_av1_dec.c" -> "hantro_drv.c";
    "hantro_drv.c" -> "hantro.h";
    "hantro_drv.c" -> "hantro_postproc.c";
    "hantro_drv.c" -> "hantro_v4l2.c";
    "hantro_drv.c" -> "rockchip_vpu981_hw_av1_dec.c";
    "v4l2-ctrls-core.c" -> "v4l2-ctrls-request.c";
    "hantro_drv.c" -> "v4l2-event.c";
    "hantro_drv.c" -> "v4l2-ctrls-request.c";
    "hantro_drv.c" -> "v4l2-ctrls-core.c";
    "hantro_drv.c" -> "v4l2-mem2mem.c";
    "rockchip_vpu981_hw_av1_dec.c" -> "videobuf2-core.h";
    "rockchip_vpu981_hw_av1_dec.c" -> "videobuf2-dma-contig.h";
    "v4l2-ctrls-request.c" -> "v4l2-ctrls-api.c";
