    "v4l2-ctrls-request.c" -> "v4l2-ctrls-priv.h";
    "hantro_v4l2.c" -> "v4l2-event.c";
    "hantro_v4l2.c" -> "v4l2-ctrls-request.c";
    "hantro_v4l2.c" -> "v4l2-common.c";
    "hantro_v4l2.c" -> "v4l2-dev.c";
    "videobuf2-v4l2.c" -> "videobuf2-core.c";
    "videobuf2-v4l2.c" -> "videobuf2-core.h";
    "v4l2-ioctl.c" -> "v4l2-ctrls-api.c";
    "v4l2-ioctl.c" -> "v4l2-dev.c";
    "v4l2-ioctl.c" -> "v4l2-mem2mem.c";
    "v4l2-ctrls-core.c" -> "v4l2-ctrls-priv.h";
    "videobuf2-core.c" -> "videobuf2-dma-contig.c";
