    "videobuf2-dma-contig.c" -> "frame_vector.c";
    "videobuf2-dma-contig.c" -> "videobuf2-memops.c";
    "v4l2-mem2mem.c" -> "videobuf2-v4l2.c";
    "hantro.h" -> "videobuf2-dma-contig.h";
    
    // Core Subsystem & Kernel Connections
    "videobuf2-core.c" -> "bug.h";
    "hantro_drv.c" -> "v4l2-mem2mem.h";
    "hantro_drv.c" -> "pm_runtime.h";
