#!/usr/bin/env bpftrace

/*
 * SKIPPED FUNCTIONS
 * The following functions were not found in available_filter_functions
 * and have been excluded to prevent kprobe attach errors:
 *
 * - vb2_mem_ops->alloc calls vb2_dma_sg_alloc
 * - vb2_mem_ops->alloc calls vb2_vmalloc_alloc
 * - vb2_mem_ops->attach_dmabuf calls vb2_dma_sg_attach_dmabuf
 * - vb2_mem_ops->attach_dmabuf calls vb2_vmalloc_attach_dmabuf
 * - vb2_mem_ops->cookie calls vb2_dma_sg_cookie
 * - vb2_mem_ops->detach_dmabuf calls vb2_dma_sg_detach_dmabuf
 * - vb2_mem_ops->detach_dmabuf calls vb2_vmalloc_detach_dmabuf
 * - vb2_mem_ops->finish calls vb2_dma_sg_finish
 * - vb2_mem_ops->get_dmabuf calls vb2_dma_sg_get_dmabuf
 * - vb2_mem_ops->get_dmabuf calls vb2_vmalloc_get_dmabuf
 * - vb2_mem_ops->get_userptr calls vb2_dma_sg_get_userptr
 * - vb2_mem_ops->get_userptr calls vb2_vmalloc_get_userptr
 * - vb2_mem_ops->map_dmabuf calls vb2_dma_sg_map_dmabuf
 * - vb2_mem_ops->map_dmabuf calls vb2_vmalloc_map_dmabuf
 * - vb2_mem_ops->num_users calls vb2_dma_sg_num_users
 * - vb2_mem_ops->num_users calls vb2_vmalloc_num_users
 * - vb2_mem_ops->prepare calls vb2_dma_sg_prepare
 * - vb2_mem_ops->put calls vb2_dma_sg_put
 * - vb2_mem_ops->put calls vb2_vmalloc_put
 * - vb2_mem_ops->put_userptr calls vb2_dma_sg_put_userptr
 * - vb2_mem_ops->put_userptr calls vb2_vmalloc_put_userptr
 * - vb2_mem_ops->unmap_dmabuf calls vb2_dma_sg_unmap_dmabuf
 * - vb2_mem_ops->unmap_dmabuf calls vb2_vmalloc_unmap_dmabuf
 * - vb2_mem_ops->vaddr calls vb2_dma_sg_vaddr
 * - vb2_mem_ops->vaddr calls vb2_vmalloc_vaddr
 */

BEGIN
{
    printf("Tracing ops functions... Hit Ctrl-C to view counts.\n");
}

